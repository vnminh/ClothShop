# Image trên Docker Hub
IMAGE=leevox/clothshop-omni:v15

SITE_NAME=clothshop.localhost
HTTP_PORT=8080
MAILPIT_PORT=8025
ADMIN_PASSWORD=admin
DB_ROOT_PASSWORD=admin

# AI Agent dự báo nhu cầu (OpenRouter -> DeepSeek). Để trống thì hệ thống chỉ dùng dự báo thống kê.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# 1 = nạp dữ liệu demo (cửa hàng, sản phẩm, 78 tuần doanh số) khi khởi tạo
SEED_DEMO=1
